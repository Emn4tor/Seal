{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Seal",
  "mainBinaryName": "Seal",
  "version": "0.2.0",
  "identifier": "de.emn4tor.seal",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Seal",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUzMDZCQkRBQTU3NDg3MApSV1J3U0ZlcXZXc3dCUmZ6SXlyV0trSXU2cmVjeEZqclA4dmlicGlLTkM2MTlPMFJxZk5iZEFJNQo=",
      "endpoints": [
        "https://github.com/Emn4tor/Seal/releases/latest/download/latest.json"
      ]
    }
  }
}
